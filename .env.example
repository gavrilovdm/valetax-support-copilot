# Which LLM backend the co-pilot uses.
#   anthropic — official Anthropic SDK (production path: prompt caching, structured outputs, effort).
#   proxy     — any OpenAI-compatible /v1/chat/completions endpoint that fronts Claude
#               (used during development; see docs/decisions/ADR-017-llm-backends.md).
COPILOT_LLM_BACKEND=anthropic
COPILOT_MODEL=claude-sonnet-5-5

# anthropic backend
ANTHROPIC_API_KEY=

# proxy backend
COPILOT_LLM_BASE_URL=http://127.0.0.1:8787/v1
COPILOT_LLM_API_KEY=

# DeepSeek API (optional comparison model; any model named deepseek-* goes here)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
